            <Icon>
                <href>img/pin-verde.png</href>
            </Icon>
        </IconStyle>
    </Style>

    <!-- POLIGONO -->

    <Placemark>

        <name>Polígono propuesto Xalixintla</name>

        <styleUrl>#poligono</styleUrl>

        <Polygon>
            <outerBoundaryIs>
                <LinearRing>
                    <coordinates>
                        -98.56209658235954,19.07947114925349
                        -98.5572792113135,19.08023730061072
                        -98.55563582409142,19.07701982275723
                        -98.5573482278752,19.07832506352785
                        -98.55853029738296,19.07858057196018
                        -98.55958148095762,19.07817582481748
                        -98.56158665109422,19.07840996035637
                        -98.56207569959709,19.07891358270906
                        -98.56209658235954,19.07947114925349
                    </coordinates>
                </LinearRing>
            </outerBoundaryIs>
        </Polygon>

    </Placemark>

    <!-- PUNTO 1 -->

    <Placemark>

        <name>Puntos de referencia 1</name>

        <styleUrl>#waypoint-pin_1</styleUrl>

        <description><![CDATA[
            estacionamiento...3
        ]]></description>

        <Point>
