<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>

    <!-- ESTILOS -->

    <Style id="poligono">
        <LineStyle>
            <color>ff00ff00</color>
            <width>2</width>
        </LineStyle>
        <PolyStyle>
            <color>7f00ff00</color>
        </PolyStyle>
    </Style>

    <Style id="waypoint-pin_1">
        <IconStyle>
            <scale>1.3</scale>
            <Icon>
                <href>img/pin-rojo.png</href>
            </Icon>
        </IconStyle>
    </Style>

    <Style id="waypoint-pin_2">
